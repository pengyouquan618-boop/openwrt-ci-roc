CONFIG_PREBUILD_SCRIPT="echo '#include \"ipq6018.dtsi\";\n/ {\n\taliases {\n\t\tbootargs-overlay = &bootargs;\n\t};\n};\n&nand {\n\tstatus = \"okay\";\n\tpartitions {\n\t\tcompatible = \"fixed-partitions\";\n\t\t#address-cells = <1>;\n\t\t#size-cells = <1>;\n\t\tpartition@0 { label = \"SBL1\"; reg = <0x00000000 0x00040000>; read-only; };\n\t\tpartition@40000 { label = \"MIBIB\"; reg = <0x00040000 0x00040000>; read-only; };\n\t\tpartition@80000 { label = \"QSEE\"; reg = <0x00080000 0x00140000>; read-only; };\n\t\tpartition@1c0000 { label = \"QSEE_HOB\"; reg = <0x001c0000 0x00040000>; read-only; };\n\t\tpartition@200000 { label = \"CDT\"; reg = <0x00200000 0x00040000>; read-only; };\n\t\tpartition@240000 { label = \"DDRPARAMS\"; reg = <0x00240000 0x00040000>; read-only; };\n\t\tpartition@280000 { label = \"APPSBLENV\"; reg = <0x00280000 0x00040000>; read-only; };\n\t\tpartition@2c0000 { label = \"APPSBL\"; reg = <0x002c0000 0x00380000>; read-only; };\n\t\tpartition@640000 { label = \"APPSBL_HOB\"; reg = <0x00640000 0x00040000>; read-only; };\n\t\tpartition@680000 { label = \"ART\"; reg = <0x00680000 0x00040000>; read-only; };\n\t\tpartition@6c0000 { label = \"ubi\"; reg = <0x006c0000 0x1d400000>; };\n\t};\n};' > target/linux/qualcommax/dts/ipq6018-redmi-router-ax5.dts; sed -i 's/DISTRIB_DESCRIPTION=.*/DISTRIB_DESCRIPTION=\"TikTok-wrt 业务专用防关联软路由\"/' package/base-files/files/etc/openwrt_release"
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_redmi-router-ax5=y
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_11_4=y
CONFIG_ATH11K_NSS_MESH_SUPPORT=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_SingBox=y
CONFIG_PACKAGE_luci-app-passwall2_Xray=y
CONFIG_PACKAGE_luci-app-passwall2_NaiveProxy=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_minidlna=n
# 下面这行：预装argon配置，写入默认标题，刷完开机自动生效左上角TikTok-wrt
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PREINIT_SCRIPT="echo 'option logo_text \"TikTok-wrt\"' >> /etc/argon/argon.conf"
